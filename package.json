{
  "name": "qr-zero",
  "version": "0.2.0",
  "description": "Zero-dependency QR code encoder for JavaScript/TypeScript — numeric, alphanumeric and byte modes with automatic segmentation, versions 1–40, EC L/M/Q/H, SVG, canvas and terminal output, React component and CLI",
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "svg",
    "canvas",
    "react",
    "cli",
    "zero-dependency",
    "typescript",
    "encoder"
  ],
  "author": "Fady Ehab Amer",
  "license": "MIT",
  "homepage": "https://github.com/fadyehabamer/qr-zero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadyehabamer/qr-zero.git"
  },
  "bugs": {
    "url": "https://github.com/fadyehabamer/qr-zero/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qr-zero": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup",
    "build:playground": "npm run build && node playground/build.mjs",
    "playground": "npm run build && node playground/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "size": "npm run build && node scripts/size.mjs",
    "check:pack": "npm run build && bash scripts/check-pack.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tsup": {
      "esbuild": "$esbuild"
    }
  }
}
