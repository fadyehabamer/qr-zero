{
  "name": "qr-zero",
  "version": "0.1.0",
  "description": "Zero-dependency QR code encoder for JavaScript/TypeScript — byte mode, versions 1–40, EC L/M/Q/H, SVG output",
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "svg",
    "zero-dependency",
    "typescript",
    "encoder"
  ],
  "author": "Fady Ehab Amer",
  "license": "MIT",
  "homepage": "https://github.com/fadyehabamer/qr-zero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadyehabamer/qr-zero.git"
  },
  "bugs": {
    "url": "https://github.com/fadyehabamer/qr-zero/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qr-zero": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "size": "npm run build && node scripts/size.mjs",
    "check:pack": "npm run build && bash scripts/check-pack.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
